      Data: 141|UnityEngine.TooltipAttribute, UnityEngine.CoreModule
    - Name: tooltip
      Entry: 1
      Data: "\uD6C4\uC5F0 \uD30C\uD2F0\uD074. \uBC1C\uC0AC \uC2DC \uBC29\uCD9C\uC744
        \uCF1C\uACE0 \uD3ED\uBC1C \uC2DC \uBC29\uCD9C\uB9CC \uB048\uB2E4 \u2014 \uC774\uBBF8
        \uBFCC\uB9B0 \uC5F0\uAE30\uB294 \uC218\uBA85\uC774 \uB2E4\uD560 \uB54C\uAE4C\uC9C0
        \uB0A8\uB294\uB2E4. \uAEBC\uC9C4 \uC624\uBE0C\uC81D\uD2B8\uC758 \uD30C\uD2F0\uD074\uC740
        \uBC14\uB85C \uC0AC\uB77C\uC9C0\uBBC0\uB85C DisableOnExplode\uC5D0 \uB123\uC9C0
        \uB9D0\uACE0, Simulation Space\uB294 World\uB85C \uB454\uB2E4(Local\uC774\uBA74
        \uC5F0\uAE30\uAC00 \uBBF8\uC0AC\uC77C\uC744 \uB530\uB77C\uB2E4\uB2CC\uB2E4).
        ExplosionDuration\uC744 \uD30C\uD2F0\uD074 \uC218\uBA85 \uC774\uC0C1\uC73C\uB85C
        \uB454\uB2E4"
