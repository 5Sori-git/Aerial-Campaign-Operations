      Data: 71|UnityEngine.TooltipAttribute, UnityEngine.CoreModule
    - Name: tooltip
      Entry: 1
      Data: "\uC2DC\uCEE4 \uBC94\uC704(\uB3C4): \uAE30\uC218\uC640 \uD0C0\uAC9F \uBC29\uD5A5\uC774
        \uC774 \uAC01\uB3C4\uBCF4\uB2E4 \uBC8C\uC5B4\uC9C0\uBA74 \uADF8 \uD504\uB808\uC784\uC740
        \uCD94\uC801\uD558\uC9C0 \uBABB\uD55C\uB2E4. \uD0C0\uAC9F\uC744 \uC9C0\uB098\uCE58\uBA74
        \uC790\uC5F0\uD788 \uC5EC\uAE30\uC5D0 \uAC78\uB9B0\uB2E4. \uD50C\uB808\uC774\uC5B4
        \uBB34\uC7A5(ACO_DFUNC_Missile)\uC774 \uC3D8\uBA74 \uBC1C\uC0AC\uB9C8\uB2E4
        '\uC774 \uD504\uB9AC\uD339 \uAC12 \xD7 \uAC15\uD654 SEEKER CONE'(\uBB34\uC7A5
        LockAngle \uC774\uC0C1)\uC73C\uB85C \uB36E\uC5B4\uC4F4\uB2E4 \u2014 \uB77D\uC628
        \uAC01\uB3C4\uC640\uB294 \uB2E4\uB978 \uAC12"
