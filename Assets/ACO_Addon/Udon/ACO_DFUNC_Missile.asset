      Data: 58|UnityEngine.TooltipAttribute, UnityEngine.CoreModule
    - Name: tooltip
      Entry: 1
      Data: "\uB2E8\uC77C \uB77D\uC628(MaxLockTargets = 1)\uC77C \uB54C: \uB2E4\uB978
        \uD45C\uC801\uC774 \uC9C0\uAE08 \uD45C\uC801\uBCF4\uB2E4 \uAE30\uC900 \uBC29\uD5A5(\uD0D0\uC0C9
        \uC6D0 \uAC00\uC6B4\uB370)\uC5D0 \uC774 \uAC01\uB3C4(\uB3C4) \uC774\uC0C1
        \uB354 \uAC00\uAE4C\uC6B0\uBA74 \uADF8\uCABD\uC73C\uB85C \uC62E\uACA8 \uC7A1\uB294\uB2E4.
        \uC9C0\uAE08 \uD45C\uC801 \uAC01\uB3C4\uC758 25%\uC640 \uC774 \uAC12 \uC911
        \uD070 \uCABD \u2014 \uB450 \uD45C\uC801 \uC0AC\uC774\uC5D0\uC11C \uAE5C\uBE61\uC774\uC9C0
        \uC54A\uAC8C. 0\uC774\uBA74 \uD55C\uBC88 \uC7A1\uC740 \uD45C\uC801\uC744
        \uAC01\uB3C4 \uBC16\uC73C\uB85C \uB098\uAC08 \uB54C\uAE4C\uC9C0 \uC720\uC9C0"
