      Data: 99|UnityEngine.TooltipAttribute, UnityEngine.CoreModule
    - Name: tooltip
      Entry: 1
      Data: "\uBBF8\uC158 \uC2E4\uD328 \uB300\uC0AC: 0 = \uC2DC\uAC04 \uCD08\uACFC(\uBAA8\uB4C8
