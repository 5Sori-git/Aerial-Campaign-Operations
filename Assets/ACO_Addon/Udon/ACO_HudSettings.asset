    - Name: header
      Entry: 1
      Data: "\uD56D\uBAA9 (ITEM_* \uC21C\uC11C: \uD328\uB110 \uC88C\uC6B0, \uC0C1\uD558,
        \uAC70\uB9AC, \uD06C\uAE30, \uB9C8\uCEE4 \uD06C\uAE30, \uC815\uBCF4 \uAC01\uB3C4,
        \uD06C\uB85C\uC2A4\uD5E4\uC5B4, \uD06C\uB85C\uC2A4\uD5E4\uC5B4 \uD06C\uAE30,
        RWR, RWR \uB9C1 \uBC18\uACBD, \uACB0\uACFC \uC88C\uC6B0, \uACB0\uACFC \uC0C1\uD558,
        \uACB0\uACFC \uD06C\uAE30, \uD06C\uB85C\uC2A4\uD5E4\uC5B4\xB7RWR \uAC70\uB9AC,
        \uC790\uB9C9 \uC88C\uC6B0, \uC790\uB9C9 \uC0C1\uD558, \uC790\uB9C9 \uD06C\uAE30,
        RWR \uBBF8\uC0AC\uC77C \uD45C\uC2DC \uD06C\uAE30, RWR \uB77D\uC628 \uD638
        \uD06C\uAE30, \uB808\uC774\uB354, \uB808\uC774\uB354 \uD06C\uAE30, \uB808\uC774\uB354
        \uC88C\uC6B0, \uB808\uC774\uB354 \uC0C1\uD558, \uB808\uC774\uB354 \uBD88\uD22C\uBA85\uB3C4,
        HUD \uB530\uB77C\uC624\uB294 \uC9C0\uC5F0, \uB808\uC774\uB354 \uD45C\uC2DC
        \uAC70\uB9AC, \uB808\uC774\uB354 \uC810 \uD06C\uAE30, \uBE44\uD589 HUD, \uBE44\uD589
        HUD \uD06C\uAE30, \uBE44\uD589 HUD \uBC1D\uAE30, \uAC70\uB9AC \uB2E8\uC704)"
