      Data: 91|UnityEngine.TooltipAttribute, UnityEngine.CoreModule
    - Name: tooltip
      Entry: 1
      Data: "\uC774\uB984 \uC55E \uC74C\uC808. \uC790\uB9AC\uB9C8\uB2E4 \uC55E +
        \uB4A4 \uC74C\uC808\uC744 \uC9C0\uD615 \uC528\uC557\uC73C\uB85C \uACE8\uB77C
        \uBD99\uC778\uB2E4(\uC608: KEL + DALE = KELDALE). \uAE30\uBCF8 TMP \uD3F0\uD2B8\uB77C
        \uC601\uBB38 \uB300\uBB38\uC790\xB7\uC22B\uC790\xB7\uACF5\uBC31\uB9CC \uC4F4\uB2E4.
