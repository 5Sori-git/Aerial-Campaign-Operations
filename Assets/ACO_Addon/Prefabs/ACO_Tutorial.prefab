  - {fileID: 5107180621730522290}
  LocKo:
  - "?  \uD29C\uD1A0\uB9AC\uC5BC"
  - "1 / 5   \uAC1C\uC694"
  - AERIAL CAMPAIGN OPERATIONS
  - "\uCD5C\uB300 4\uBA85\uC774 \uD568\uAED8\uD558\uB294 \uD611\uB3D9 \uACF5\uC911\uC804"
  - "\uB9E4\uBC88 \uC0C8\uB85C\uC6B4 \uC804\uC7A5"
  - "\uBBF8\uC158\uB9C8\uB2E4 \uC12C \uC9C0\uD615\uC774 \uC0C8\uB85C \uB9CC\uB4E4\uC5B4\uC9D1\uB2C8\uB2E4.
    \uAD70\uB3C4, \uD611\uACE1, \uD658\uCD08, \uD654\uC0B0\uC12C\uCC98\uB7FC \uB9E4\uBC88
    \uB2E4\uB978 \uC804\uC7A5"
  - "\uB2E4\uC591\uD55C \uC801\uACFC \uC791\uC804"
  - "\uC81C\uACF5\uAD8C \uC7A5\uC545, \uD638\uC704, \uC0C1\uB959\uC804, \uD568\uB300\uC804\uBD80\uD130
    \uACF5\uC911 \uC694\uC0C8, \uC721\uC0C1\uC804\uD568, \uC5D0\uC774\uC2A4 \uD3B8\uB300\uAE4C\uC9C0"
  - "\uCEA0\uD398\uC778\uACFC \uB09C\uC774\uB3C4"
  - "\uC791\uC804 \uCF58\uC194\uC5D0\uC11C \uC5F0\uC18D \uC784\uBB34 \uC218\uB97C
    \uACE0\uB985\uB2C8\uB2E4. \uAE38\uAC8C \uC774\uC5B4\uAC08\uC218\uB85D \uD50C\uB808\uC774
    \uC2DC\uAC04\uC774 \uB298\uACE0 \uAC15\uD55C \uC801\uC774 \uB098\uC62C \uD655\uB960\uC774
    \uB192\uC544\uC9D1\uB2C8\uB2E4"
  - "\uD06C\uB808\uB527\uACFC \uC131\uC7A5"
  - "\uBCF4\uC0C1\uC73C\uB85C \uB2E4\uC591\uD55C \uD2B9\uC218\uBB34\uC7A5\uC744 \uD574\uAE08\uD558\uACE0
    \uAE30\uCCB4\uC640 \uBB34\uC7A5\uC744 \uAC15\uD654\uD569\uB2C8\uB2E4. \uCD9C\uACA9
    \uC911\uC5D0 \uBD80\uB97C \uC218 \uC788\uB294 \uC9C0\uC6D0\uB3C4 \uC788\uC2B5\uB2C8\uB2E4"
  - "2 / 5   \uCD9C\uACA9 \uBC29\uBC95"
  - "\uCC38\uAC00"
  - "\uC815\uBA74 \uBE0C\uB9AC\uD551 \uCF58\uC194\uC5D0\uC11C \uBE48 \uCE78(JOIN)\uC744
    \uB204\uB974\uC138\uC694"
  - "\uBB34\uC7A5"
  - "\uC624\uB978\uCABD \uBCBD \uB85C\uB4DC\uC544\uC6C3 \uD328\uB110\uC5D0\uC11C
    \uD2B9\uC218\uBB34\uC7A5, \uC9C0\uC6D0 \uD638\uCD9C, \uAC15\uD654\uB97C \uACE0\uB974\uC138\uC694"
  - "\uC900\uBE44"
  - "\uBAA8\uB450 READY\uB97C \uB204\uB974\uBA74 10\uCD08 \uCE74\uC6B4\uD2B8\uB2E4\uC6B4\uC774
    \uC2DC\uC791\uB429\uB2C8\uB2E4"
  - "\uCD9C\uACA9"
  - "\uBAA8\uB4E0 \uC870\uC885\uC0AC\uAC00 \uBE44\uD589\uAC11\uD310\uC5D0\uC11C \uD568\uAED8
    \uCD9C\uACA9\uD569\uB2C8\uB2E4"
  - "\uC791\uC804 \uCF58\uC194 \uB9E8 \uC704\uC5D0 \uC9C0\uAE08 \uD560 \uC77C\uC774
    \uD45C\uC2DC\uB429\uB2C8\uB2E4"
  - "\uACA9\uCD94\uB418\uBA74 \uB85C\uB4DC\uC544\uC6C3 \uD328\uB110\uC758 LAUNCH\uB85C
    \uB2E4\uC2DC \uCD9C\uACA9\uD569\uB2C8\uB2E4"
  - "3 / 5   \uBE44\uD589 \uC911"
  - "\uB370\uC2A4\uD06C\uD1B1"
  - VR
  - "\uC2A4\uB85C\uD2C0  <color=#F0FFF4><b>Shift / Ctrl</b></color>"
  - "\uC67C\uC190 \uADF8\uB9BD = \uC2A4\uB85C\uD2C0 (\uC190\uC744 \uC55E\uB4A4\uB85C)"
  - "\uD53C\uCE58\xB7\uB864  <color=#F0FFF4><b>W A S D</b></color>    \uC694  <color=#F0FFF4><b>Q
    E</b></color>"
  - "\uC624\uB978\uC190 \uADF8\uB9BD = \uC870\uC885\uAC04 (\uC190\uC744 \uAE30\uC6B8\uC774\uAE30)"
  - "<color=#F0FFF4><b>1</b></color> \uAE30\uAD00\uD3EC    <color=#F0FFF4><b>2</b></color>
    \uBBF8\uC0AC\uC77C"
  - "\uC624\uB978\uCABD \uB2E4\uC774\uC5BC: \uAE30\uAD00\uD3EC, \uBBF8\uC0AC\uC77C,
    \uD2B9\uC218\uBB34\uC7A5, \uC9C0\uC6D0"
  - "<color=#F0FFF4><b>3</b></color> \uD2B9\uC218\uBB34\uC7A5    <color=#F0FFF4><b>4</b></color>
    \uC9C0\uC6D0 \uD638\uCD9C"
  - "\uC67C\uCABD \uB2E4\uC774\uC5BC: \uD50C\uB7A9, \uD50C\uB808\uC5B4, \uBE0C\uB808\uC774\uD06C,
    \uAE30\uC5B4"
  - "\uBC1C\uC0AC  <color=#F0FFF4><b>Space</b></color>    \uD50C\uB808\uC5B4  <color=#F0FFF4><b>X</b></color>"
  - "\uC2A4\uD2F1\uC73C\uB85C \uACE0\uB974\uACE0 \uD2B8\uB9AC\uAC70\uB85C \uC0AC\uC6A9"
  - "\uB0B4\uB9AC\uAE30  <color=#F0FFF4><b>Enter</b></color> \uB450 \uBC88"
  - "\uC810\uD504 \uD55C \uBC88 = \uC88C\uC11D \uB192\uC774 \uB9DE\uCD94\uAE30, \uB450
    \uBC88 = \uB0B4\uB9AC\uAE30"
  - "\uBBF8\uC0AC\uC77C\xB7\uD2B9\uC218\uBB34\uC7A5: \uAE30\uC218 \uC55E\uC758 \uC801\uC744
    \uC790\uB3D9\uC73C\uB85C \uC870\uC900\uD569\uB2C8\uB2E4. \uB77D\uC628 \uB9C8\uCEE4\uAC00
    \uBE68\uAC1B\uAC8C \uBC14\uB00C\uBA74 \uBC1C\uC0AC\uD558\uC138\uC694. \uC3DC
    \uCE78\uC740 \uBA87 \uCD08 \uB4A4 \uB2E4\uC2DC \uC7A5\uC804\uB429\uB2C8\uB2E4"
  - "\uC9C0\uC6D0 \uD638\uCD9C: \uB85C\uB4DC\uC544\uC6C3 \uD328\uB110\uC5D0\uC11C
    \uACE0\uB978 \uC9C0\uC6D0\uC744 \uBD80\uB985\uB2C8\uB2E4. \uC704\uCE58\uAC00
    \uD544\uC694\uD55C \uC9C0\uC6D0\uC740 \uBC14\uB77C\uBCF4\uB294 \uACF3\uC744 \uC9C0\uC815\uD569\uB2C8\uB2E4"
  - "\uCE90\uD130\uD384\uD2B8: \uB178\uB780 \uC637 \uC720\uB3C4\uC694\uC6D0\uC758
    \uC2E0\uD638\uB97C \uB530\uB77C \uCE90\uD130\uD384\uD2B8\uC5D0 \uC624\uB974\uACE0,
    \uC0AC\uCD9C\uC7A5\uAD50\uAC00 \uC2E0\uD638\uD558\uBA74 \uC2A4\uB85C\uD2C0\uC744
    \uB05D\uAE4C\uC9C0(\uC560\uD504\uD130\uBC84\uB108) \uC62C\uB9AC\uC138\uC694.
    \uC810\uAC80\uC774 \uB05D\uB098\uBA74 \uC0AC\uCD9C\uB429\uB2C8\uB2E4(\uC124\uC815\uC5D0\uC11C
    \uAC11\uD310 \uC694\uC6D0\uC744 \uB044\uBA74 \uD480\uC2A4\uB85C\uD2C0 2\uCD08)"
  - "\uCC29\uD568\uD558\uC9C0 \uC54A\uC544\uB3C4 \uBBF8\uC158\uC774 \uB05D\uB098\uBA74
    \uBE0C\uB9AC\uD551\uC2E4\uB85C \uB3CC\uC544\uC635\uB2C8\uB2E4"
  - "4 / 5   \uD06C\uB808\uB527\uACFC \uAC15\uD654"
  - "\uBBF8\uC158\uC774 \uB05D\uB098\uBA74 \uBCF4\uC0C1\uC744 \uBC1B\uC2B5\uB2C8\uB2E4:
    \uD300 \uC810\uC218\uC758 \uC808\uBC18 + \uB0B4 \uACA9\uCD94 \uC810\uC218"
  - "\uACA9\uCD94\uB418\uAC70\uB098 \uD568\uC120 \uBC16\uC5D0\uC11C \uC870\uC885\uC11D\uC744
    \uB0B4\uB9AC\uBA74 \uBCF4\uC0C1\uC774 \uC904\uC5B4\uB4ED\uB2C8\uB2E4"
  - "\uB85C\uB4DC\uC544\uC6C3 \uD328\uB110\uC5D0\uC11C \uD2B9\uC218\uBB34\uC7A5 \uD574\uAE08,
    \uAE30\uCCB4\uC640 \uBB34\uC7A5 \uAC15\uD654, \uC7A5\uBE44(\uBBF8\uC158 1\uD68C
    \uC801\uC6A9), \uC9C0\uC6D0 \uD638\uCD9C\uAD8C(\uC4F8 \uB54C\uAE4C\uC9C0 \uBCF4\uAD00)"
  - "\uC9C4\uD589\uC740 VRChat \uACC4\uC815\uC5D0 \uC800\uC7A5\uB418\uC5B4 \uB2E4\uC74C\uC5D0\uB3C4
    \uC774\uC5B4\uC9D1\uB2C8\uB2E4"
  - "5 / 5   \uD568\uB0B4 \uC9C0\uB3C4"
  - "\uBE0C\uB9AC\uD551\uC2E4 \xB7 \uC9C0\uAE08 \uC704\uCE58"
  - "CIC \xB7 \uAD00\uC804 \uD654\uBA74"
  - "\uBCF5\uB3C4 \xB7 \uD558\uC774\uC2A4\uCF54\uC5B4"
  - "\uC120\uC6D0\uC2E4 \xB7 \uC124\uC815"
  - "\uACA9\uB0A9\uACE0 \xB7 \uCEE4\uC2A4\uD130\uB9C8\uC774\uC9D5"
  - "\uBE44\uD589\uAC11\uD310 \xB7 \uAD00\uC804"
  - "\uACA9\uB0A9\uACE0\uC640 \uBE44\uD589\uAC11\uD310\uC740 \uBCF5\uB3C4 \uB05D
    \uBB38\uC744 \uB20C\uB7EC(Interact) \uC774\uB3D9\uD569\uB2C8\uB2E4"
  LocEn:
  - '?  TUTORIAL'
  - 1 / 5   Overview
  - AERIAL CAMPAIGN OPERATIONS
  - Co-op air combat for up to 4 pilots
  - Fresh Battlefields
  - 'Island terrain is generated fresh for every mission: archipelagos, canyons,
    atolls, volcanic islands and more'
  - Varied Missions
  - From air superiority, escorts, landings and fleet battles to flying fortresses,
    land battleships and ace squadrons
  - Campaigns & Difficulty
  - Choose how many missions to chain on the operations console. Longer campaigns
    take more time and bring stronger enemies more often
  - Credits & Upgrades
  - Spend rewards to unlock special weapons and upgrade your aircraft and weapons.
    You can also call in support mid-sortie
  - 2 / 5   How to Sortie
  - Join
  - Tap an open slot (JOIN) on the briefing console in front
  - Arm
  - Pick special weapons, support and upgrades on the LOADOUT panel (right wall)
  - Ready
  - When everyone presses READY, a 10-second countdown starts
  - Launch
  - All pilots launch together from the flight deck
  - The top of the operations console shows what to do next
  - If you are shot down, press LAUNCH on the LOADOUT panel to sortie again
  - 3 / 5   In Flight
  - Desktop
  - VR
  - Throttle  <color=#F0FFF4><b>Shift / Ctrl</b></color>
  - Left grip = throttle (move hand fore/aft)
  - Pitch/Roll  <color=#F0FFF4><b>W A S D</b></color>    Yaw  <color=#F0FFF4><b>Q
    E</b></color>
  - Right grip = stick (tilt your hand)
  - <color=#F0FFF4><b>1</b></color> Gun    <color=#F0FFF4><b>2</b></color> Missiles
  - 'Right dial: gun, missiles, special, support'
  - <color=#F0FFF4><b>3</b></color> Special    <color=#F0FFF4><b>4</b></color> Support
  - 'Left dial: flaps, flares, brake, gear'
  - Fire  <color=#F0FFF4><b>Space</b></color>    Flares  <color=#F0FFF4><b>X</b></color>
  - Select with the stick, use with the trigger
  - Exit  <color=#F0FFF4><b>Enter</b></color> twice
  - Jump once = adjust seat height, twice = exit
  - Missiles and special weapons aim at enemies ahead of your nose automatically.
    Fire when the lock-on marker turns red. Fired slots reload after a few seconds
  - 'Support: calls the support picked on the LOADOUT panel. Support that needs a
    location targets where you are looking'
  - 'Catapult: follow the yellow-shirt director onto the catapult. When the shooter
    signals, push the throttle all the way (afterburner). You launch after the final
    check (with deck crew off in Settings: full throttle for 2 s)'
  - 'No need to land: when the mission ends, you return to the briefing room'
  - 4 / 5   Credits and Upgrades
  - 'Rewards are paid when a mission ends: half the team score + your kill score'
  - Getting shot down or leaving the cockpit away from the ship reduces your reward
  - 'On the LOADOUT panel: unlock special weapons, upgrade aircraft and weapons,
    buy equipment (lasts one mission) and support tickets (kept until used)'
  - Progress is saved to your VRChat account and carries over
  - 5 / 5   Ship Map
  - "Briefing \xB7 You are here"
  - "CIC \xB7 Spectator screens"
  - "Corridor \xB7 High scores"
  - "Crew quarters \xB7 Settings"
  - "Hangar \xB7 Customization"
  - "Flight deck \xB7 Spectate"
  - Reach the hangar and flight deck by pressing (Interact) the doors at the end
    of the corridor
  LocJa:
  - "?  \u30C1\u30E5\u30FC\u30C8\u30EA\u30A2\u30EB"
  - "1 / 5   \u6982\u8981"
  - AERIAL CAMPAIGN OPERATIONS
  - "\u6700\u59274\u4EBA\u3067\u6311\u3080\u5354\u529B\u7A7A\u6226"
  - "\u6BCE\u56DE\u65B0\u3057\u3044\u6226\u5834"
  - "\u30DF\u30C3\u30B7\u30E7\u30F3\u3054\u3068\u306B\u5CF6\u306E\u5730\u5F62\u304C\u65B0\u3057\u304F\u751F\u6210\u3055\u308C\u307E\u3059\u3002\u7FA4\u5CF6\u3001\u5CE1\u8C37\u3001\u74B0\u7901\u3001\u706B\u5C71\u5CF6\u306A\u3069\u6BCE\u56DE\u9055\u3046\u6226\u5834"
  - "\u591A\u5F69\u306A\u6575\u3068\u4F5C\u6226"
  - "\u5236\u7A7A\u6A29\u306E\u78BA\u4FDD\u3001\u8B77\u885B\u3001\u4E0A\u9678\u6226\u3001\u8266\u968A\u6226\u304B\u3089\u7A7A\u4E2D\u8981\u585E\u3001\u9678\u4E0A\u6226\u8266\u3001\u30A8\u30FC\u30B9\u7DE8\u968A\u307E\u3067"
  - "\u30AD\u30E3\u30F3\u30DA\u30FC\u30F3\u3068\u96E3\u6613\u5EA6"
  - "\u4F5C\u6226\u30B3\u30F3\u30BD\u30FC\u30EB\u3067\u9023\u7D9A\u30DF\u30C3\u30B7\u30E7\u30F3\u6570\u3092\u9078\u3073\u307E\u3059\u3002\u9577\u304F\u7D9A\u3051\u308B\u307B\u3069\u30D7\u30EC\u30A4\u6642\u9593\u304C\u5EF6\u3073\u3001\u5F37\u6575\u306E\u51FA\u73FE\u7387\u304C\u4E0A\u304C\u308A\u307E\u3059"
  - "\u30AF\u30EC\u30B8\u30C3\u30C8\u3068\u5F37\u5316"
  - "\u5831\u916C\u3067\u69D8\u3005\u306A\u7279\u6B8A\u5175\u88C5\u3092\u89E3\u653E\u3057\u3001\u6A5F\u4F53\u3068\u5175\u88C5\u3092\u5F37\u5316\u3057\u307E\u3059\u3002\u51FA\u6483\u4E2D\u306B\u547C\u3079\u308B\u652F\u63F4\u3082\u3042\u308A\u307E\u3059"
  - "2 / 5   \u51FA\u6483\u306E\u624B\u9806"
  - "\u53C2\u52A0"
  - "\u6B63\u9762\u306E\u30D6\u30EA\u30FC\u30D5\u30A3\u30F3\u30B0\u30B3\u30F3\u30BD\u30FC\u30EB\u3067\u7A7A\u304D\u67A0(JOIN)\u3092\u62BC\u3057\u307E\u3059"
  - "\u5175\u88C5"
  - "\u53F3\u58C1\u306E\u30ED\u30FC\u30C9\u30A2\u30A6\u30C8\u30D1\u30CD\u30EB\u3067\u7279\u6B8A\u5175\u88C5\u3001\u652F\u63F4\u8981\u8ACB\u3001\u5F37\u5316\u3092\u9078\u3073\u307E\u3059"
  - "\u6E96\u5099"
  - "\u5168\u54E1\u304CREADY\u3092\u62BC\u3059\u306810\u79D2\u306E\u30AB\u30A6\u30F3\u30C8\u30C0\u30A6\u30F3\u304C\u59CB\u307E\u308A\u307E\u3059"
