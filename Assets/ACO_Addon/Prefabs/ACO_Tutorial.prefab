  - "\u30AD\u30EB\u30DE\u30FC\u30AF"
  - "1\u56DE\u306E\u30DF\u30C3\u30B7\u30E7\u30F3\u3067\u5012\u3057\u305F\u6570\u306E\u6700\u9AD8\u8A18\u9332\u304C\u6A5F\u4F53\u306B\u30DE\u30FC\u30AF\u3067\u8868\u793A\u3055\u308C\u307E\u3059(\u81EA\u52D5)"
  - "7 / 9   \u30D5\u30EA\u30FC\u30D5\u30E9\u30A4\u30C8"
  - "\u30AA\u30F3"
  - "\u4F5C\u6226\u30B3\u30F3\u30BD\u30FC\u30EB\u306EFREE FLIGHT\u30DC\u30BF\u30F3\u3067\u30AA\u30F3\u306B\u3057\u307E\u3059\u3002\u5207\u308A\u66FF\u3048\u3089\u308C\u308B\u306E\u306F\u30A4\u30F3\u30B9\u30BF\u30F3\u30B9\u306E\u30AA\u30FC\u30CA\u30FC\u3060\u3051\u3067\u3001\u30DC\u30BF\u30F3\u306E\u4E0B\u306B\u540D\u524D\u304C\u8868\u793A\u3055\u308C\u307E\u3059"
  - "\u642D\u4E57"
  - "\u540D\u7C3F\u306B\u53C2\u52A0\u3057\u3066\u3044\u308C\u3070\u30ED\u30FC\u30C9\u30A2\u30A6\u30C8\u30D1\u30CD\u30EB\u306ELAUNCH\u3067\u98DB\u884C\u7532\u677F\u3078\u3001\u305D\u3046\u3067\u306A\u3051\u308C\u3070\u7A7A\u3044\u3066\u3044\u308B\u6A5F\u4F53\u306E\u30B3\u30C3\u30AF\u30D4\u30C3\u30C8\u3092\u62BC\u3057\u3066\u305D\u306E\u307E\u307E\u4E57\u308A\u307E\u3059"
  - "\u98DB\u884C"
  - "\u6575\u3082\u30DF\u30C3\u30B7\u30E7\u30F3\u3082\u3042\u308A\u307E\u305B\u3093\u3002\u964D\u308A\u3066\u3082\u6A5F\u4F53\u306F\u305D\u306E\u5834\u306B\u6B8B\u308A\u3001\u5175\u88C5\u30FB\u5F37\u5316\u30FB\u30AB\u30B9\u30BF\u30DE\u30A4\u30BA\u3082\u305D\u306E\u307E\u307E\u306A\u306E\u3067\u3001\u307E\u305F\u4E57\u3063\u3066\u7D9A\u3051\u3089\u308C\u307E\u3059"
  - "\u30AA\u30D5"
  - "\u30AA\u30D5\u306B\u3059\u308B\u3068\u5168\u54E1\u304C\u964D\u308A\u3066\u30D6\u30EA\u30FC\u30D5\u30A3\u30F3\u30B0\u30EB\u30FC\u30E0\u306B\u623B\u308A\u3001\u5730\u5F62\u304C\u65B0\u3057\u304F\u751F\u6210\u3055\u308C\u307E\u3059"
  - "\u30D5\u30EA\u30FC\u30D5\u30E9\u30A4\u30C8\u4E2D\u306F\u5831\u916C\u304C\u3042\u308A\u307E\u305B\u3093\u3002\u5730\u5F62\u306E\u518D\u751F\u6210(NEW
    TERRAIN)\u306F\u3067\u304D\u307E\u3059"
  - "\u30AA\u30F3\u30FB\u30AA\u30D5\u306E\u5207\u308A\u66FF\u3048\u306B\u306F10\u79D2\u306E\u5F85\u3061\u6642\u9593\u304C\u3042\u308A\u307E\u3059"
  - 8 / 9   BGM
  - "\u30D6\u30EA\u30FC\u30D5\u30A3\u30F3\u30B0 \xB7 BGM\u30D1\u30CD\u30EB"
  - "\u8239\u54E1\u5BA4 \xB7 \u52D5\u753B\u30D7\u30EC\u30A4\u30E4\u30FC"
  - "\u52D5\u753B\u3092GLOBAL\u3067\u8074\u304F\u3068\u304D\u306F\u3001DYNAMIC BGM\u3092\u30AA\u30D5\u306B\u3059\u308B\u3068\u97F3\u304C\u91CD\u306A\u308A\u307E\u305B\u3093"
  - "\u30C0\u30A4\u30CA\u30DF\u30C3\u30AFBGM"
  - "\u5236\u4F5C\u8005\u304C\u3042\u3089\u304B\u3058\u3081\u8A2D\u5B9A\u3057\u305F\u3001\u4EFB\u52D9\u306E\u72B6\u6CC1(\u5F85\u6A5F\u4E2D\u30FB\u30D5\u30A7\u30FC\u30BA\u30FB\u30DC\u30B9\u6226)\u306B\u5408\u3063\u305F\u30C8\u30E9\u30C3\u30AF\u3092\u30B9\u30C8\u30EA\u30FC\u30DF\u30F3\u30B0\u3067\u304A\u5C4A\u3051\u3057\u307E\u3059\u3002\u5168\u54E1\u304C\u540C\u3058\u66F2\u3092\u8074\u304D\u307E\u3059(\u30B0\u30ED\u30FC\u30D0\u30EB)"
  - "\u97F3\u91CF \xB7 \u518D\u751F\u4E2D\u306E\u66F2"
  - "\u30D6\u30EA\u30FC\u30D5\u30A3\u30F3\u30B0\u30EB\u30FC\u30E0\u306EBGM\u30D1\u30CD\u30EB\u306E
    \u2212 / + \u3067\u97F3\u91CF\u3092\u5909\u3048\u3001\u518D\u751F\u4E2D\u306E\u66F2\u540D\u3092\u78BA\u8A8D\u3067\u304D\u307E\u3059\u3002\u30ED\u30FC\u30AB\u30EB\u8A2D\u5B9A\u3067\u3001\u4FDD\u5B58\u3055\u308C\u307E\u3059"
  - "BGM\u306E\u30AA\u30F3\u30FB\u30AA\u30D5"
  - "DYNAMIC BGM\u30DC\u30BF\u30F3\u3067\u30AA\u30D5\u306B\u3067\u304D\u307E\u3059(\u30ED\u30FC\u30AB\u30EB)\u3002\u30AA\u30D5\u306E\u9593\u306F\u66F2\u3092\u8AAD\u307F\u8FBC\u307F\u307E\u305B\u3093"
  - "\u8239\u54E1\u5BA4\u306E\u52D5\u753B\u30D7\u30EC\u30A4\u30E4\u30FC"
  - "TV\u306B\u52D5\u753B\u306EURL\u3092\u5165\u308C\u3066\u4E00\u7DD2\u306B\u8996\u8074\u3067\u304D\u307E\u3059(\u30B0\u30ED\u30FC\u30D0\u30EB)\u3002\u4E0B\u306E\u30BB\u30C3\u30C8\u30C8\u30C3\u30D7\u30DC\u30C3\u30AF\u30B9\u306E\u30DC\u30BF\u30F3\u3067NEAR(\u8239\u54E1\u5BA4\u306E\u4E2D\u3060\u3051)\u30FBGLOBAL(\u51FA\u6483\u4E2D\u3082\u3069\u3053\u3067\u3082)\u3092\u5207\u308A\u66FF\u3048\u307E\u3059(\u30ED\u30FC\u30AB\u30EB\u8A2D\u5B9A)"
  - "9 / 9   \u8266\u5185\u30DE\u30C3\u30D7"
  - "\u30D6\u30EA\u30FC\u30D5\u30A3\u30F3\u30B0 \xB7 \u73FE\u5728\u5730"
  - "CIC \xB7 \u4F5C\u6226\u30C6\u30FC\u30D6\u30EB \xB7 \u89B3\u6226"
  - "\u5ECA\u4E0B \xB7 \u30CF\u30A4\u30B9\u30B3\u30A2"
  - "\u8239\u54E1\u5BA4 \xB7 \u8A2D\u5B9A"
  - "\u683C\u7D0D\u5EAB \xB7 \u30AB\u30B9\u30BF\u30DE\u30A4\u30BA"
  - "\u98DB\u884C\u7532\u677F \xB7 \u89B3\u6226"
  - "\u683C\u7D0D\u5EAB\u3068\u98DB\u884C\u7532\u677F\u3078\u306F\u5ECA\u4E0B\u306E\u7AEF\u306E\u30C9\u30A2\u3092\u62BC\u3057\u3066(Interact)\u79FB\u52D5\u3057\u307E\u3059"
