    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=120%><b>2026-11-15</b></size>\n\n<b>COMBAT</b>\n\u2022 Fixed enemy
    jets and ground units turning invisible and following you, or not taking damage
    when hit\n    - Kills are now confirmed by the unit's owner, so every screen
    shows the same result\n    - Targets shot down by another player may explode
    a little later (about 0.3 s)\n\u2022 Fixed VIPs, bosses and aces sometimes not
    showing 100% health right after spawning\n\u2022 Fixed wrong health bars on VIPs
    and boss parts for players who joined late\n\u2022 Reduced damage being lost
    when an enemy jet changes owner mid-fight\n\u2022 Fixed special weapons firing
    together with the gun\n\n<b>CARRIER</b>\n\u2022 Fixed the catapult JBD (blast
    deflector) staying raised\n\n<b>SOUND \xB7 HUD \xB7 TUTORIAL</b>\n\u2022 Fixed
    the BGM sometimes going silent\n    - If a track fails to load, it moves to another
    track and retries a little later\n\u2022 HUD settings: position now adjusts in
    1 cm steps, and the defaults were tuned\n\u2022 The tutorial now explains the
    afterburner (Desktop: T, VR: throttle fully forward)\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 0d86b0a79cdf7f642bd0eb2f512bbb61, type: 2}
  m_sharedMaterial: {fileID: -7288332935827949165, guid: 0d86b0a79cdf7f642bd0eb2f512bbb61,
    type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
  m_fontMaterials: []
